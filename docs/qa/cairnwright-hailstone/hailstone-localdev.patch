diff --git a/src/net/nightcap_creation.h b/src/net/nightcap_creation.h
new file mode 100644
index 0000000..6136a79
--- /dev/null
+++ b/src/net/nightcap_creation.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "net/world_packets.h"
+#include <algorithm>
+#include <string_view>
+
+namespace hailstone::net {
+
+inline bool nightcap_qa_world(std::string_view host, std::string_view name) {
+    return (host == "127.0.0.1" || host == "localhost" || host == "::1") && name == "Local Development Server";
+}
+
+// The local world validates class 17 but omits it from the table sent to stock RoF2.
+// Mirror only the row specified by Nightcap's cairnwright_creation.sql.
+inline void add_nightcap_creation_option(CharCreateData& data) {
+    if (std::any_of(data.combos.begin(), data.combos.end(), [](const auto& c) { return c.class_ == 17; })) return;
+    const auto base = std::find_if(data.combos.begin(), data.combos.end(), [](const auto& c) {
+        return c.race == 8 && c.class_ == 3 && c.deity == 202 && c.zone == 67 &&
+               c.allocation_index == 14 && c.expansion_required == 0;
+    });
+    if (base == data.combos.end()) return;
+    const auto matches = [](const CharCreateAllocation& a) {
+        return a.index == 14 && a.base == std::array<std::uint32_t,7>{100,90,70,95,60,88,55} &&
+               a.points == std::array<std::uint32_t,7>{0,0,0,20,0,0,0};
+    };
+    if (std::none_of(data.allocations.begin(), data.allocations.end(), matches)) return;
+    auto cairnwright = *base;
+    cairnwright.class_ = 17;
+    data.combos.push_back(cairnwright);
+}
+
+} // namespace hailstone::net
diff --git a/tools/nightcap_ui_probe.h b/tools/nightcap_ui_probe.h
new file mode 100644
index 0000000..d1c4630
--- /dev/null
+++ b/tools/nightcap_ui_probe.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include "app/lua_ui.h"
+#include "net/world_packets.h"
+#include "ui/dev_screens.h"
+#include <lua.hpp>
+#include <cstdio>
+
+// Exercise the same pregame API as the modern skin, using the actual world's
+// options. Reproduce the owner's Warrior -> name -> Cairnwright sequence.
+inline const hailstone::net::CharCreateCombo* choose_dwarf_cairnwright(
+    const hailstone::net::CharCreateData& data, std::uint32_t expansions, const std::string& name) {
+    using namespace hailstone;
+    ui::CharacterCreateView view;
+    for (const auto& c : data.combos) {
+        if (!net::char_create_allowed(c, expansions)) continue;
+        const auto cc = net::default_char_create(data, c, 0);
+        if (!cc) continue;
+        const auto alloc = net::validate_char_create(data, *cc);
+        if (alloc) view.options.push_back({c.race, c.class_, c.deity, c.zone, alloc->base, alloc->points});
+    }
+    app::UiHost host;
+    host.char_create_view = &view;
+    app::UiApi api{host};
+    lua_State* lua = luaL_newstate();
+    if (!lua) return nullptr;
+    luaL_openlibs(lua);
+    lua_newtable(lua);
+    api.register_functions(lua);
+    lua_setglobal(lua, "hs");
+    lua_pushlstring(lua, name.data(), name.size());
+    lua_setglobal(lua, "qa_name");
+    const int result = luaL_dostring(lua, R"(
+        assert(hs.CharacterCreateDo('race', 8))
+        assert(hs.CharacterCreateDo('class', 1))
+        assert(hs.CharacterCreateDo('name', qa_name))
+        assert(hs.CharacterCreateDo('class', 17))
+        local v = hs.CharacterCreate()
+        assert(v.className == 'Cairnwright' and v.name == qa_name)
+        if v.pointsLeft > 0 then assert(hs.CharacterCreateDo('statMax', 4)) end
+        assert(hs.CharacterCreate().pointsLeft == 0)
+        assert(hs.CharacterCreateDo('create'))
+    )");
+    if (result != LUA_OK) std::fprintf(stderr, "creation UI: %s\n", lua_tostring(lua, -1));
+    lua_close(lua);
+    if (result != LUA_OK || host.char_create_action != static_cast<int>(ui::CharacterCreateAction::Create) ||
+        view.option < 0 || static_cast<std::size_t>(view.option) >= view.options.size()) return nullptr;
+    const auto& selected = view.options[static_cast<std::size_t>(view.option)];
+    for (const auto& c : data.combos)
+        if (c.race == selected.race && c.class_ == selected.class_id &&
+            c.zone == selected.start_zone && c.deity == selected.deity) return &c;
+    return nullptr;
+}
