the Earthcrafter</td><td>0</td><td>2</td><td>4</td><td>6</td></tr><tr><td>Pulsing Emerald Hoop</td><td>0</td><td>3</td><td>5</td><td>8</td></tr><tr><td>Radiant Mask of the Disease Lord</td><td>15</td><td>16</td><td>18</td><td>19</td></tr><tr><td>Ring of Flowing Stones</td><td>0</td><td>4</td><td>9</td><td>13</td></tr><tr><td>Ring of Force</td><td>15</td><td>17</td><td>18</td><td>20</td></tr><tr><td>Ring of Rage</td><td>10</td><td>11</td><td>11</td><td>12</td></tr><tr><td>Runed Signet</td><td>0</td><td>5</td><td>10</td><td>15</td></tr><tr><td>Runewarded Belt</td><td>30</td><td>32</td><td>33</td><td>35</td></tr><tr><td>Sable Shoes of Flame</td><td>0</td><td>6</td><td>13</td><td>19</td></tr><tr><td>Serrated Dart of Energy</td><td>0</td><td>3</td><td>7</td><td>10</td></tr><tr><td>Shaded Amice</td><td>0</td><td>5</td><td>10</td><td>15</td></tr><tr><td>Shadow Footpads</td><td>0</td><td>2</td><td>5</td><td>7</td></tr><tr><td>Shadow Pearl Earring</td><td>0</td><td>3</td><td>5</td><td>8</td></tr><tr><td>Sharkbone Plated Shoulderpads</td><td>20</td><td>22</td><td>25</td><td>27</td></tr><tr><td>Shellplated Armguards</td><td>0</td><td>5</td><td>9</td><td>14</td></tr><tr><td>Shield of Spiked Energy</td><td>0</td><td>6</td><td>12</td><td>18</td></tr><tr><td>Shiny Trinket of Speed</td><td>0</td><td>4</td><td>9</td><td>13</td></tr><tr><td>Silver Disk</td><td>0</td><td>4</td><td>9</td><td>13</td></tr><tr><td>Silver Steel Cloak</td><td>0</td><td>2</td><td>3</td><td>5</td></tr><tr><td>Simple Ring of Purity</td><td>0</td><td>3</td><td>7</td><td>10</td></tr><tr><td>Smooth Onyx Torque</td><td>0</td><td>3</td><td>6</td><td>9</td></tr><tr><td>Staff of Transcendence</td><td>0</td><td>10</td><td>20</td><td>30</td></tr><tr><td>Stone Etched Mallet</td><td>0</td><td>6</td><td>12</td><td>18</td></tr><tr><td>Tactician's Shield</td><td>0</td><td>3</td><td>6</td><td>9</td></tr><tr><td>Temporal Chainmail Sleeves</td><td>25</td><td>26</td><td>27</td><td>28</td></tr><tr><td>The Sword of Ssraeshza</td><td>0</td><td>7</td><td>13</td><td>20</td></tr><tr><td>Timestone Adorned Ring</td><td>0</td><td>6</td><td>12</td><td>18</td></tr><tr><td>Tiny Bone Bracelet</td><td>0</td><td>2</td><td>5</td><td>7</td></tr><tr><td>Ton Po's Chestwraps of Composure</td><td>0</td><td>9</td><td>19</td><td>28</td></tr><tr><td>Ton Po's Leggings of Composure</td><td>40</td><td>42</td><td>45</td><td>47</td></tr><tr><td>Ton Po's Sandals of Composure</td><td>20</td><td>22</td><td>23</td><td>25</td></tr><tr><td>Ton Po's Sleeves of Composure</td><td>30</td><td>32</td><td>33</td><td>35</td></tr><tr><td>Trydan's Armplates of Nobility</td><td>25</td><td>27</td><td>28</td><td>30</td></tr><tr><td>Trydan's Bracer of Nobility</td><td>15</td><td>16</td><td>18</td><td>19</td></tr><tr><td>Trydan's Chestplate of Nobility</td><td>0</td><td>9</td><td>19</td><td>28</td></tr><tr><td>Trydan's Gauntlets of Nobility</td><td>30</td><td>32</td><td>33</td><td>35</td></tr><tr><td>Trydan's Greaves of Nobility</td><td>40</td><td>42</td><td>45</td><td>47</td></tr><tr><td>Trydan's Helm of Nobility</td><td>0</td><td>6</td><td>13</td><td>19</td></tr><tr><td>Valiant Belt of Fallen Heroes</td><td>0</td><td>4</td><td>8</td><td>12</td></tr><tr><td>Vanazir, Dreamer's Despair</td><td>0</td><td>5</td><td>10</td><td>15</td></tr><tr><td>Vengeful Mail of the Void</td><td>0</td><td>6</td><td>11</td><td>17</td></tr><tr><td>Visor of Endless Sight</td><td>0</td><td>3</td><td>7</td><td>10</td></tr><tr><td>Warden's Buckler</td><td>0</td><td>4</td><td>8</td><td>12</td></tr><tr><td>Whispering Air Bangle</td><td>20</td><td>22</td><td>23</td><td>25</td></tr><tr><td>Winged Storm Boots</td><td>0</td><td>4</td><td>9</td><td>13</td></tr><tr><td>Wristband of Icy Vengeance</td><td>0</td><td>3</td><td>7</td><td>10</td></tr><tr><td>Wristband of Judgement</td><td>0</td><td>2</td><td>3</td><td>5</td></tr><tr><td>Yttrium Studded Mantle</td><td>0</td><td>4</td><td>8</td><td>12</td></tr><tr><td>Yttrium Wrapped Sleeves</td><td>0</td><td>3</td><td>7</td><td>10</td></tr></tbody></table></div></details>",
