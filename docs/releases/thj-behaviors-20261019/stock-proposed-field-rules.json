{
  "version": 1,
  "status": "read-only research proposal; not implemented, deployed, or balance accepted",
  "source_manifest": "source-manifest.json",
  "source_authority": "Unmodified public ProjectEQ stock emulator database; not a Daybreak database and not a recovered THJ database",
  "archive_url": "https://db.eqemu.dev/api/v1/dump/archive/peq-1792195214.zip",
  "archive_sha256": "c27a943e73890cdfd4ac2b1e30e58d557d2d3e4254030836888eacf4f102ef18",
  "scope": {
    "included": "Existing ordinary equipment families with exact base+200000/+400000/+600000 identity/name mapping and a matching pinned stock base row",
    "excluded": [
      "209 approved modest starter families",
      "custom dungeon and hunt families",
      "ordinary bags",
      "augments",
      "epic+800000 families except existing exact observed overrides",
      "unmatched or renamed stock identities",
      "materials, consumables, scrolls and other non-equipment"
    ],
    "unchanged": [
      "Classic level50 and era acquisition gates",
      "Normal numeric stock values except existing209 starter policy",
      "class/race/level equip gates",
      "all effect/click/proc/focus/worn fields",
      "all sockets, socket visibility and augment restrictions",
      "pet/WPM companion effects and sockets",
      "ownership, inventory, recipes, loot and prices"
    ],
    "observed_overrides": "Retain reviewed exact131 item targets after generalized rules; exact target fields override the statistical model. Missing evidence fields are unknown, never zero."
  },
  "rounding": "For nonnegative rational x use floor(x+1/2); retain negative stock fields unchanged; reject representational overflow rather than silently wrapping.",
  "ascended": {
    "double_positive": {
      "fields": [
        "ac",
        "hp",
        "mana",
        "astr",
        "asta",
        "aagi",
        "adex",
        "aint",
        "awis",
        "acha",
        "mr",
        "fr",
        "cr",
        "dr",
        "pr",
        "damage",
        "regen",
        "manaregen"
      ],
      "expression": "2 * stock when stock>0; retain zero and negative values",
      "notes": [
        "Damage support is only5 weapons: Dragonspine Rapier, Shuriken of Eternity, Hammer of Divinity, Sharpened Bloodtusk Lance, Water Sprinkler of Nem Ankh. General weapon application is an explicit calibration, not131 observed weapon ratios.",
        "HP, mana and stat additions from zero stay exact-item exceptions.",
        "Mana7 positive exceptions and STA2 positive exceptions remain exact overrides."
      ]
    },
    "haste": {
      "expression": "round_half_up(stock.haste*3/2) when stock.haste>0; otherwise retain stock",
      "positive_matches": 9,
      "positive_observations": 9
    },
    "spelldmg": {
      "expression": "max(2*max(stock.aint,0),max(stock.awis,0)) when stock.spelldmg==0; otherwise preserve stock.spelldmg",
      "positive_matches": 119,
      "positive_observations": 120,
      "all_matches": 127,
      "all_observations": 128,
      "notes": [
        "All128 observed stock Spell Damage values are zero; these are additions, not ratios.",
        "max(2INT,WIS) and (INT>0?2INT:WIS) cannot be distinguished here: no sampled positiveINT item has WIS>2INT. Selecting max is Nightcap calibration.",
        "Sharpened Bloodtusk Lance has observed8 versus candidate16, from an older2024 screenshot."
      ]
    },
    "healamt": {
      "expression": "2*max(stock.awis,0) when stock.healamt==0; otherwise preserve stock.healamt",
      "positive_matches": 93,
      "positive_observations": 94,
      "all_matches": 125,
      "all_observations": 126,
      "notes": [
        "All126 observed stock Healing Amount values are zero.",
        "Sharpened Bloodtusk Lance has observed8 versus candidate16."
      ]
    },
    "accuracy": {
      "expression": "ceil(max(stock.adex,0)/2) when stock.accuracy==0; otherwise preserve stock.accuracy",
      "positive_matches": 70,
      "positive_observations": 71,
      "all_matches": 125,
      "all_observations": 127,
      "exceptions": [
        "Magi`Kot sleeves11598 expected9 but observed0",
        "Sharpened Bloodtusk Lance40035 expected5 but observed3"
      ]
    },
    "heroics": {
      "expression": "round_half_up(max(final corresponding primary/resist,0)/4) when stock heroic field==0; otherwise preserve stock heroic field",
      "positive_matches": 967,
      "positive_observations": 986,
      "all_matches": 1412,
      "all_observations": 1431,
      "notes": [
        "Quarter rule has19 positive exceptions; retain exact observed overrides.",
        "Do not silently add inferred heroics on top of a positive native heroic field, a case absent from this sample."
      ]
    },
    "preserve_stock": {
      "fields": [
        "endur",
        "enduranceregen",
        "delay",
        "range",
        "backstabdmg",
        "elemdmgamt",
        "damageshield",
        "shielding",
        "spellshield",
        "avoidance",
        "strikethrough",
        "combateffects",
        "stunresist",
        "svcorruption",
        "heroic_svcorrup"
      ],
      "notes": [
        "Endurance unchanged12/13 positive observations; last is doubled.",
        "Advanced utility fields are unchanged on observed nonzero rows; zeros do not establish scaling.",
        "Backstab4x has one observation; do not extrapolate.",
        "No endurance-regen or corruption evidence.",
        "Preserving weapon delay is well supported; no global faster-delay policy."
      ]
    },
    "attack": {
      "recommendation": "Keep native stock attack for unobserved families until choosing this explicit nonlinear calibration; retain exact observed target attack values.",
      "optional_candidate": "stock.attack>0 ? stock.attack+ceil(max(stock.astr,0)/4) : ceil((max(stock.astr,0)+max(stock.adex,0))/2)",
      "positive_matches": 104,
      "positive_observations": 107,
      "all_matches": 125,
      "all_observations": 128,
      "exceptions": [
        "Shuriken14733 expected30 observed118",
        "Sharpened Bloodtusk Lance40035 expected5 observed3",
        "Bracer of Timeless Rage68198 expected23 observed25"
      ],
      "notes": [
        "A125/128 fit is descriptive, not proof of the upstream algorithm.",
        "Observed stockattack>0 ratios range1.0\u20134.72; do not apply their1.2 median as a universal multiplier."
      ]
    }
  },
  "intermediate": {
    "recommendation": "Use deterministic1/3 and2/3 interpolation of each modeled/reviewed positive Normal\u2192Ascended delta for ordinary scalar stats. Retain top-tier-only heroics as a separate current Nightcap policy.",
    "polished": "N + round_half_up((T-N)/3)",
    "exalted": "N + round_half_up(2*(T-N)/3)",
    "ascended": "T",
    "normal": "N",
    "heroics": "Preserve current Polished/Exalted heroic fields; generated additions begin only at Ascended unless intentionally changing this separate contract.",
    "requirements": [
      "No lower-tier THJ observations are present in this131-item catalog. Label the interpolation as Nightcap calibration.",
      "Interpolate the final exact top target for observed fields; ensure Normal<=Polished<=Exalted<=Ascended for supported positive upgrade fields.",
      "For T=N all intermediates are N. Negative stats and nonnumeric/effect fields are unchanged.",
      "Accept low-integer plateaus; do not force+1 if it exceeds the endpoint.",
      "Normal identity or stock numeric drift rejects planning unless covered by a reviewed explicit exception.",
      "Heroic interpolation at1/3 and2/3 would grant new lower-tier heroics; do not treat that behavior as inferred evidence."
    ],
    "comparison_with_deployed": "2x endpoint yields\u22481.333/1.667 of Normal instead of old HP/mana1.45/1.90/2.40 and damage1.10/1.20/1.35. AC/core1.35/1.65/2.00 was already close. Interpolation prevents an old1.9HP middle tier sitting almost at2x top."
  },
