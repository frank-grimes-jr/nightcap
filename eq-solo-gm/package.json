{
  "name": "eq-solo-gm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"API,UI\" --prefix-colors \"yellow,cyan\" \"node api/server.cjs\" \"vite\"",
    "api": "node api/server.cjs",
    "frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\" \"api/**/*.{js,cjs}\"",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "vue-tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "express": "^4.19.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "mysql2": "^3.10.0",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^8.2.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.11"
  }
}
